# Copy to .env.local and fill in. Vite exposes any VITE_-prefixed var to the client bundle.

# WalletConnect Cloud project ID. Required for the WalletConnect "Connect" button.
# Get one at https://cloud.reown.com (formerly cloud.walletconnect.com).
VITE_WALLETCONNECT_PROJECT_ID=

# Optional. Placeholder chain(s) advertised in optionalNamespaces.canton.chains
# during the WC session proposal. Comma-separated. The wallet may approve with
# any operator-defined chain it actually supports; the adapter reads the real
# chain back from session.namespaces.canton on approval.
# VITE_CANTON_CHAIN_ID=canton:devnet

# Optional. Splice Scan API base URL — fallback path for balance queries when
# the wallet denies canton_ledgerApi proxy (typical for restricted WC mobile
# wallets that whitelist only the 7 standard CIP-0103 methods). Falls back to
# a per-network default (see KNOWN_SCAN_URLS_BY_NETWORK in src/App.tsx) for
# canton:da-mainnet, canton:da-devnet, canton:da-testnet.
# VITE_SCAN_API_URL=https://scan.sv-1.global.canton.network.sync.global/api/scan
